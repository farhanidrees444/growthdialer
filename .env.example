# ─── Auth ──────────────────────────────────────────────────────────────────────
AUTH_SECRET=your-auth-secret-min-32-chars        # openssl rand -base64 32
AUTH_TRUST_HOST=true

# Google OAuth (optional — remove if not using)
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# ─── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (create products in Stripe Dashboard)
STRIPE_STARTER_PRICE_ID=price_starter_...
STRIPE_GROWTH_PRICE_ID=price_growth_...
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_...

# ─── Polar ─────────────────────────────────────────────────────────────────────
POLAR_ACCESS_TOKEN=polar_pat_...
POLAR_WEBHOOK_SECRET=whsec_...
POLAR_PRODUCT_STARTER_MONTHLY=00000000-0000-0000-0000-000000000000
POLAR_PRODUCT_STARTER_ANNUAL=00000000-0000-0000-0000-000000000000
POLAR_PRODUCT_GROWTH_MONTHLY=00000000-0000-0000-0000-000000000000
POLAR_PRODUCT_GROWTH_ANNUAL=00000000-0000-0000-0000-000000000000
POLAR_PRODUCT_PRO_MONTHLY=00000000-0000-0000-0000-000000000000
POLAR_PRODUCT_PRO_ANNUAL=00000000-0000-0000-0000-000000000000

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Voice (primary telephony provider) ───────────────────────────────────────
TELNYX_API_KEY=KEY..._secret
TELNYX_PUBLIC_KEY=your-voice-webhook-public-key
TELNYX_CALL_CONTROL_APP_ID=your-call-control-application-id
TELNYX_OUTBOUND_VOICE_PROFILE_ID=your-outbound-voice-profile-id
TELNYX_CONNECTION_ID=your-sip-credential-connection-id
TELNYX_VOICE_WEBHOOK_URL=https://app.growthdialer.com/api/telnyx/webhook
TELNYX_SMS_WEBHOOK_URL=https://app.growthdialer.com/api/telnyxsms/webhook
TELNYX_MESSAGING_PROFILE_ID=your-messaging-profile-id
TELNYX_FROM_NUMBER=+1XXXXXXXXXX
# Local dev only — never set in production
TELNYX_SKIP_WEBHOOK_VERIFY=false

# Legacy Twilio routes (deprecated — remove after telephony cutover)
TWILIO_ACCOUNT_SID=AC...
TWILIO_API_KEY=SK...
TWILIO_API_SECRET=your-api-key-secret
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_TWIML_APP_SID=AP...
TWILIO_NUMBER=+1XXXXXXXXXX

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
